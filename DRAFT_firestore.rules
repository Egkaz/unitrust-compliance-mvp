rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.3 Primitives
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'ovrerking@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. User Profiles
    match /users/{userId} {
      function isValidUserProfile(data) {
        return data.keys().hasAll(['uid', 'email', 'role']) &&
               data.keys().size() <= 7 &&
               data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 256 &&
               data.role in ['student', 'faculty', 'admin'] &&
               (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000));
      }

      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().role == existing().role; // Role is immutable for users
    }

    // 2. Policies
    match /policies/{policyId} {
      function isValidPolicy(data) {
        return data.keys().hasAll(['title', 'category', 'content', 'status']) &&
               data.title is string && data.title.size() <= 200 &&
               data.category is string && data.category.size() <= 100 &&
               data.content is string && data.content.size() <= 10000 &&
               data.status in ['active', 'archived', 'draft'];
      }

      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidPolicy(incoming());
    }

    // 3. Incident Reports
    match /reports/{reportId} {
      function isValidReport(data) {
        return data.keys().hasAll(['description', 'status', 'createdAt']) &&
               data.description is string && data.description.size() <= 5000 &&
               data.status in ['pending', 'reviewed', 'resolved'] &&
               data.createdAt == request.time &&
               (data.userId == null || data.userId == request.auth.uid);
      }

      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidReport(incoming()) && (incoming().status == 'pending');
      allow update: if isAdmin() && isValidReport(incoming()); // Only admin can update status or analysis
    }

    // 4. Training
    match /training/{trainingId} {
      function isValidTraining(data) {
        return data.keys().hasAll(['userId', 'moduleId', 'progress', 'status']) &&
               data.userId == request.auth.uid &&
               data.moduleId is string && data.moduleId.size() <= 100 &&
               data.progress is number && data.progress >= 0 && data.progress <= 100 &&
               data.status in ['Not Started', 'In Progress', 'Completed', 'Locked'];
      }

      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isOwner(incoming().userId) && isValidTraining(incoming());
    }
  }
}
